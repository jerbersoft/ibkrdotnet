<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform, which the .NET 10 SDK requires
         'dotnet test' to opt into (see dotnet.config at the repository root). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CS1591: test code needs no documentation comments.
         CA1707: underscores make test names readable as sentences.
         CA1034: nested records model one-off JSON shapes next to the test that uses them.
         CA5350: the OAuth 1.0a tests must use HMAC-SHA1, because IBKR's protocol does. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1034;CA5350</NoWarn>
  </PropertyGroup>

  <!--
    Test assemblies keep their real source paths.

    Source Link turns on DeterministicSourcePaths under ContinuousIntegrationBuild, which rewrites
    every embedded path to /_/... so that two machines building the same commit produce identical
    binaries. That is exactly right for the packages under src/, which ship. It is wrong here:
    RepositoryLayout and PublicApiApproval find the repository from [CallerFilePath], and a
    normalised path points at a directory that does not exist. On a CI machine the approval test
    fails with UnauthorizedAccessException on '/_' rather than on anything to do with the API.

    Nothing in tests/ is published, so there is nothing for determinism to buy here.
  -->
  <PropertyGroup>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NodaTime.Testing" />
  </ItemGroup>

</Project>
