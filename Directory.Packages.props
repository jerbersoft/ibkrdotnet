<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="NodaTime" Version="3.3.3" />
    <PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Test-only packages. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="NodaTime.Testing" Version="3.3.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
  </ItemGroup>

  <!--
    There is deliberately no Microsoft.SourceLink.GitHub reference here.

    The .NET SDK has carried Source Link in-box since .NET 8 and wires up the GitHub provider on its
    own. Referencing the package explicitly does not reinforce that — it REPLACES it, and the
    standalone package does not enable the source-control queries the SDK's copy turns on. The
    symptom is silent and survives a green build: packages pack, tests pass, and the nuspec simply
    has no commit attribute while the symbol package has no source URLs, so nobody can step into the
    source of a published package. It shipped that way in 0.1.0 and 0.2.0.

    PackagingTests asserts this cannot regress unnoticed again.
  -->

</Project>
