<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>IbkrDotNet.Extensions.DependencyInjection</PackageId>
    <Description>Dependency injection registration extensions for IbkrDotNet.Trading, wiring the Interactive Brokers Web API Trading client into Microsoft.Extensions.DependencyInjection.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>IbkrDotNet.Extensions.DependencyInjection</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IbkrDotNet.Trading/IbkrDotNet.Trading.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IbkrDotNet.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
